# Build output
x64/
Debug/
Release/

# Visual Studio
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb

# Object files
*.obj
*.pdb
*.ilk
*.exp
*.lib

# Executables
*.exe
*.dll

# CMake
build/
out/

# Tiled editor
*.tiled-session

# macOS
.DS_Store

# Python virtual environments
.venv/
**/.venv/

# Python generated files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# VS Code local files
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace

